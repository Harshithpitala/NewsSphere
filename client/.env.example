# NewsSphere Frontend Environment Configuration Example

# Backend Base API URL (e.g. https://newssphere-api.onrender.com/api/v1 for production)
VITE_API_URL=/api/v1

# Backend Server Root URL for media uploads & static assets (e.g. https://newssphere-api.onrender.com for production)
VITE_SERVER_URL=http://localhost:5000

# Backend Socket.IO Server URL (e.g. https://newssphere-api.onrender.com for production)
VITE_SOCKET_URL=http://localhost:5000

# Site Title & Branding
VITE_SITE_NAME=NewsSphere
